{
  "name": "@libp2p/example-yjs-libp2p",
  "version": "1.0.0",
  "description": "A Yjs collaborative editor using libp2p for peer-to-peer connectivity",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "relay": "node relay.js",
    "relay:debug": "DEBUG=libp2p:* node relay.js",
    "pretest": "npm run build",
    "test": "npm run build && npm run test:chrome && npm run test:firefox && npm run test:webkit",
    "test:firefox": "npm run build && playwright test --project=firefox",
    "test:chrome": "npm run build && playwright test --project=chromium",
    "test:webkit": "npm run build && playwright test --project=webkit"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@helia/delegated-routing-v1-http-api-client": "^4.2.5",
    "@libp2p/autonat": "^3.0.24",
    "@libp2p/bootstrap": "^12.0.27",
    "@libp2p/circuit-relay-v2": "^4.2.9",
    "@libp2p/crypto": "^5.1.21",
    "@libp2p/dcutr": "^3.0.24",
    "@libp2p/gossipsub": "^16.1.0",
    "@libp2p/identify": "^4.1.10",
    "@libp2p/interface": "^3.2.5",
    "@libp2p/interface-internal": "^3.1.11",
    "@libp2p/kad-dht": "^16.4.3",
    "@libp2p/peer-id": "^6.0.0",
    "@libp2p/ping": "^3.1.9",
    "@libp2p/pubsub-peer-discovery": "^12.0.0",
    "@libp2p/tcp": "^11.0.26",
    "@libp2p/utils": "^7.3.0",
    "@libp2p/webrtc": "^6.0.27",
    "@libp2p/websockets": "^10.1.17",
    "@libp2p/webtransport": "^6.0.35",
    "@multiformats/multiaddr": "^12.4.0",
    "it-first": "^3.0.6",
    "it-length-prefixed": "^10.0.1",
    "it-map": "^3.1.4",
    "it-pipe": "^3.0.1",
    "it-protobuf-stream": "^1.1.5",
    "it-pushable": "^3.2.3",
    "libp2p": "^3.3.6",
    "protons-runtime": "^5.5.0",
    "uint8arraylist": "^2.4.8",
    "uint8arrays": "^5.1.0",
    "vite": "^6.0.3",
    "yjs": "^13.6.18"
  },
  "devDependencies": {
    "@eslint/css": "^0.14.0",
    "@eslint/js": "^9.38.0",
    "@eslint/json": "^0.13.2",
    "@eslint/markdown": "^7.5.0",
    "@playwright/test": "^1.56.1",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "protons": "^7.7.0",
    "test-ipfs-example": "^1.0.0"
  }
}
